<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Albarán - tabla de movimientos no validados (state != 'done').
        Itera sobre stock.move: un registro por producto, sin duplicar por lote.
    -->
    <template id="report_delivery_virtual_boxes" inherit_id="stock.report_delivery_document">
        <!-- Cabecera: después de "Delivered" -->
        <xpath expr="//th[@name='th_sm_quantity']" position="after">
            <th name="th_sm_boxes" class="text-end">Nº Cajas</th>
        </xpath>
        <!-- Celda de datos: después del td que contiene format_number(move.quantity) -->
        <xpath expr="//table[@name='stock_move_table']//td[.//span[@t-out='format_number(move.quantity)']]" position="after">
            <td class="text-end">
                <span t-if="move.num_boxes" t-out="move.num_boxes"/>
            </td>
        </xpath>
        <!-- Albarán validado: cabecera de la tabla de líneas agrupadas -->
        <xpath expr="//th[@name='th_sml_quantity']" position="after">
            <th name="th_sml_boxes" class="text-end">Nº Cajas</th>
        </xpath>
    </template>

    <!--
        Albarán validado - líneas agrupadas por producto (sin lotes impresos).
        num_boxes viene del diccionario agregado sobreescrito en stock_move_line.py.
    -->
    <template id="stock_report_delivery_aggregated_move_lines_virtual_boxes"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <td class="text-end" name="move_line_aggregated_boxes">
                <span t-if="aggregated_lines[line].get('num_boxes')"
                      t-out="aggregated_lines[line]['num_boxes']"/>
            </td>
        </xpath>
    </template>

    <!--
        Albarán validado - líneas por lote/número de serie.
        Se añade celda vacía para mantener la alineación de columnas.
    -->
    <template id="stock_report_delivery_has_serial_virtual_boxes"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td class="text-end" name="move_line_serial_boxes"/>
        </xpath>
    </template>
</odoo>
