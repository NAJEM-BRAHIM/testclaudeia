<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_claude" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.claude</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_provider']" position="after">
                <setting id="claude_provider" string="Use your own Claude account" help="Provide your API key to connect with your account" groups="base.group_system">
                    <field name="claude_key_enabled" />
                    <group invisible="not claude_key_enabled">
                        <div class="flex-grow-1">
                            <field name="claude_key" placeholder="Key" password="True" nolabel="1" class="w-100"/>
                        </div>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Add Claude settings to AI app settings view -->
    <record id="res_config_settings_view_form_inherit_ai_app_claude" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.app.claude</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai_app.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_provider']" position="after">
                <setting id="claude_provider" string="Use your own Claude account" help="Provide your API key to connect with your account" groups="base.group_system">
                    <field name="claude_key_enabled" />
                    <group invisible="not claude_key_enabled">
                        <div class="flex-grow-1">
                            <field name="claude_key" placeholder="Key" password="True" nolabel="1" class="w-100"/>
                        </div>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

