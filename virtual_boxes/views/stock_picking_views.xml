<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna Nº Cajas EDITABLE en el formulario del albarán/recepción -->
    <record id="view_picking_form_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.picking.form.virtual_boxes</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']//list//field[@name='product_uom_qty']" position="after">
                <field name="num_boxes" string="Nº Cajas"
                       help="Introduce el número de cajas para este movimiento."/>
            </xpath>
        </field>
    </record>

    <!-- Columna Nº Cajas EDITABLE por lote en Detalles de operación -->
    <record id="view_stock_move_line_operation_tree_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.virtual_boxes</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="num_boxes" string="Nº Cajas"
                       readonly="state == 'done' and is_locked"/>
            </xpath>
        </field>
    </record>

    <!-- Columna Nº Cajas en Operación Detallada (popup de detalles) -->
    <record id="view_move_line_detailed_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.virtual_boxes</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="num_boxes" string="Nº Cajas"/>
            </xpath>
        </field>
    </record>

    <!-- Columna Nº Cajas en Análisis de Movimientos -->
    <record id="view_move_tree_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.move.list.virtual_boxes</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="num_boxes" string="Nº Cajas"/>
            </xpath>
        </field>
    </record>

    <!-- Nº Cajas en inventario (vista simple) -->
    <record id="view_stock_quant_tree_simple_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.quant.list.simple.virtual_boxes</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="num_boxes" string="Nº Cajas"/>
            </xpath>
        </field>
    </record>

    <!-- Nº Cajas en inventario (editable) -->
    <record id="view_stock_quant_tree_editable_virtual_boxes" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.virtual_boxes</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="after">
                <field name="num_boxes" string="Nº Cajas"/>
            </xpath>
        </field>
    </record>
</odoo>
