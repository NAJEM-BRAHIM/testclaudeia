<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_virtual_boxes" model="ir.ui.view">
        <field name="name">account.move.form.virtual_boxes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Columna Nº Cajas en líneas de factura -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="after">
                <field name="num_boxes" string="Nº Cajas" optional="show"
                       column_invisible="parent.move_type == 'entry'"/>
            </xpath>
            <!-- Totales Unidades y Cajas encima de los importes -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <div class="d-flex gap-4 mb-2"
                     invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund','out_receipt','in_receipt')">
                    <span>
                        <strong>Total Unidades:</strong>
                        <field name="total_quantity" readonly="1" nolabel="1" class="ms-1"/>
                    </span>
                    <span>
                        <strong>Total Cajas:</strong>
                        <field name="total_boxes" readonly="1" nolabel="1" class="ms-1"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
