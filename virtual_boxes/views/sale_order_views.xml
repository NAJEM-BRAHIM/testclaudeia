<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna Nº Cajas en formulario de pedido de venta -->
    <record id="view_order_form_virtual_boxes" model="ir.ui.view">
        <field name="name">sale.order.form.virtual_boxes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="num_boxes" string="Nº Cajas" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
