<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Logo a la DERECHA — Dirección empresa a la IZQUIERDA
        Técnica: float CSS (100% compatible con wkhtmltopdf)
        optional="true" en todos los xpath para evitar crash si el template cambia
    -->

    <!-- ════════════════════════════════════════════
         Layout: STRIPED
    ════════════════════════════════════════════ -->
    <template id="external_layout_striped_logo_right" inherit_id="web.external_layout_striped">
        <xpath expr="//div[hasclass('d-flex') and div[@name='company_address']]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mw-50')]" position="attributes" optional="true">
            <attribute name="style">float: right; max-width: 50%;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="attributes" optional="true">
            <attribute name="class">w-50</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: BOXED
    ════════════════════════════════════════════ -->
    <template id="external_layout_boxed_logo_right" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[hasclass('row') and hasclass('mb8')]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('col-4') and child::img]" position="attributes" optional="true">
            <attribute name="style">float: right; width: 33.333%;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('col-8') and hasclass('text-end')]" position="attributes" optional="true">
            <attribute name="class">mb4</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: BOLD
    ════════════════════════════════════════════ -->
    <template id="external_layout_bold_logo_right" inherit_id="web.external_layout_bold">
        <xpath expr="//div[hasclass('row') and div[hasclass('col-6')]]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('col-6') and child::img]" position="attributes" optional="true">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('col-5') and hasclass('offset-1')]" position="attributes" optional="true">
            <attribute name="class">col-6</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: STANDARD
    ════════════════════════════════════════════ -->
    <template id="external_layout_standard_logo_right" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('d-flex') and hasclass('justify-content-between')]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//img[hasclass('o_company_logo_small')]" position="attributes" optional="true">
            <attribute name="style">float: right;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_company_tagline') and hasclass('mw-50')]" position="attributes" optional="true">
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: FOLDER
    ════════════════════════════════════════════ -->
    <template id="external_layout_folder_logo_right" inherit_id="web.external_layout_folder">
        <xpath expr="//div[hasclass('o_folder_company_info')]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_folder_company_info')]/div[not(@name)]" position="attributes" optional="true">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address' and hasclass('w-50')]" position="attributes" optional="true">
            <attribute name="class">w-50 text-start</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: WAVE
    ════════════════════════════════════════════ -->
    <template id="external_layout_wave_logo_right" inherit_id="web.external_layout_wave">
        <xpath expr="//div[hasclass('d-flex') and hasclass('justify-content-between')]" position="attributes" optional="true">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']/preceding-sibling::div" position="attributes" optional="true">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="attributes" optional="true">
            <attribute name="class">w-50 text-start</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: BUBBLE
         Técnica: float CSS dentro de la celda existente
    ════════════════════════════════════════════ -->
    <template id="external_layout_bubble_logo_right" inherit_id="web.external_layout_bubble">
        <xpath expr="//td[hasclass('o_company_tagline')]" position="attributes" optional="true">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//td[hasclass('p-0') and hasclass('text-end') and child::img]" position="attributes" optional="true">
            <attribute name="class">p-0</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//img[hasclass('o_company_logo')]" position="attributes" optional="true">
            <attribute name="style">float: right; max-height: 80px;</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="attributes" optional="true">
            <attribute name="style">overflow: hidden; text-align: left;</attribute>
        </xpath>
    </template>

</odoo>
