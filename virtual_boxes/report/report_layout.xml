<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Logo a la DERECHA — Dirección empresa a la IZQUIERDA
        Técnica: float CSS (100% compatible con wkhtmltopdf)
        - El contenedor flex se convierte a block (display:block overrides d-flex)
        - El logo flota a la derecha (float: right)
        - La dirección crea un BFC (overflow:hidden) y permanece a la izquierda
        Aplica a: striped, boxed, bold, standard, folder, wave
        El layout "bubble" ya tiene el logo a la derecha por defecto.
    -->

    <!-- ════════════════════════════════════════════
         Layout: STRIPED
         [LOGO mw-50 | DIRECCIÓN w-50 ms-3]  →  [DIRECCIÓN w-50 | LOGO mw-50 float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_striped_logo_right" inherit_id="web.external_layout_striped">
        <!-- Cambiar contenedor flex a block para que funcione el float -->
        <xpath expr="//div[hasclass('d-flex') and div[@name='company_address']]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo a la derecha -->
        <xpath expr="//div[hasclass('mw-50')]" position="attributes">
            <attribute name="style">float: right; max-width: 50%;</attribute>
        </xpath>
        <!-- Dirección: BFC para que no se monte sobre el float, quitar margen izquierdo -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="class">w-50</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: BOXED
         [LOGO col-4 | DIRECCIÓN col-8 text-end]  →  [DIRECCIÓN | LOGO float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_boxed_logo_right" inherit_id="web.external_layout_boxed">
        <!-- Cambiar row (flex) a block -->
        <xpath expr="//div[hasclass('row') and hasclass('mb8')]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo a la derecha -->
        <xpath expr="//div[hasclass('col-4') and child::img]" position="attributes">
            <attribute name="style">float: right; width: 33.333%;</attribute>
        </xpath>
        <!-- Dirección: BFC, texto a la izquierda -->
        <xpath expr="//div[hasclass('col-8') and hasclass('text-end')]" position="attributes">
            <attribute name="class">mb4</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: BOLD
         [LOGO col-6 | DIRECCIÓN col-5 offset-1]  →  [DIRECCIÓN col-6 | LOGO col-6 float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_bold_logo_right" inherit_id="web.external_layout_bold">
        <!-- Cambiar row (flex) a block -->
        <xpath expr="//div[hasclass('row') and div[hasclass('col-6')]]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo a la derecha -->
        <xpath expr="//div[hasclass('col-6') and child::img]" position="attributes">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <!-- Dirección: BFC, quitar offset, ajustar clases -->
        <xpath expr="//div[hasclass('col-5') and hasclass('offset-1')]" position="attributes">
            <attribute name="class">col-6</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: STANDARD
         [LOGO_pequeño | Tagline]  →  [Tagline | LOGO_pequeño float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_standard_logo_right" inherit_id="web.external_layout_standard">
        <!-- Cambiar contenedor flex a block -->
        <xpath expr="//div[hasclass('d-flex') and hasclass('justify-content-between')]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo pequeño a la derecha -->
        <xpath expr="//img[hasclass('o_company_logo_small')]" position="attributes">
            <attribute name="style">float: right;</attribute>
        </xpath>
        <!-- Tagline: BFC para mantenerse a la izquierda -->
        <xpath expr="//div[hasclass('o_company_tagline') and hasclass('mw-50')]" position="attributes">
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: FOLDER
         [LOGO w-50 | DIRECCIÓN w-50 text-end]  →  [DIRECCIÓN w-50 text-start | LOGO float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_folder_logo_right" inherit_id="web.external_layout_folder">
        <!-- Cambiar contenedor flex a block -->
        <xpath expr="//div[hasclass('o_folder_company_info')]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo a la derecha (div sin @name = logo, no dirección) -->
        <xpath expr="//div[hasclass('o_folder_company_info')]/div[not(@name)]" position="attributes">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <!-- Dirección: BFC, texto a la izquierda -->
        <xpath expr="//div[@name='company_address' and hasclass('w-50')]" position="attributes">
            <attribute name="class">w-50 text-start</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!-- ════════════════════════════════════════════
         Layout: WAVE
         [LOGO w-50 | DIRECCIÓN w-50 text-end]  →  [DIRECCIÓN w-50 text-start | LOGO float:right]
    ════════════════════════════════════════════ -->
    <template id="external_layout_wave_logo_right" inherit_id="web.external_layout_wave">
        <!-- Cambiar contenedor flex a block -->
        <xpath expr="//div[hasclass('d-flex') and hasclass('justify-content-between')]" position="attributes">
            <attribute name="style">display: block; overflow: hidden;</attribute>
        </xpath>
        <!-- Flotar logo a la derecha (div hermano anterior a company_address) -->
        <xpath expr="//div[@name='company_address']/preceding-sibling::div" position="attributes">
            <attribute name="style">float: right; width: 50%;</attribute>
        </xpath>
        <!-- Dirección: BFC, texto a la izquierda -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="class">w-50 text-start</attribute>
            <attribute name="style">overflow: hidden;</attribute>
        </xpath>
    </template>

    <!--
         Layout: BUBBLE — modificado directamente en la vista web.external_layout_bubble
         desde Ajustes > Técnico > Vistas. No se necesita override por código.
    -->

</odoo>
