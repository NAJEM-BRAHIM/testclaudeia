        </record>

        <!-- Absence non payée -->
        <record id="ma_rule_absence_np" model="hr.salary.rule">
            <field name="name">Absences Non Payées</field>
            <field name="code">ABS_NP</field>
            <field name="sequence">440</field>
            <field name="category_id" ref="ma_rule_category_retenue"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.ABS_NP and inputs.ABS_NP.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Retenue = (Salaire base / 26 jours) * nombre de jours absents
salaire_journalier = contract.wage / 26.0
result = -(inputs.ABS_NP.amount * salaire_journalier)
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">True</field>
        </record>

    </data>
</odoo>
