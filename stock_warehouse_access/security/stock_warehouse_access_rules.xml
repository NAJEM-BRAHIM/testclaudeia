<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Reglas para stock.warehouse
    ============================================================ -->

    <!-- Usuarios: solo ven los almacenes asignados -->
    <record id="rule_warehouse_user" model="ir.rule">
        <field name="name">Almacén: solo almacenes asignados (usuario)</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[('allowed_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Gestores: acceso total (desbloquea la restricción anterior) -->
    <record id="rule_warehouse_manager" model="ir.rule">
        <field name="name">Almacén: acceso total (gestor)</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================
         Reglas para stock.picking (transferencias/albaranes)
    ============================================================ -->

    <!-- Usuarios: solo ven transferencias de sus almacenes asignados -->
    <record id="rule_picking_user" model="ir.rule">
        <field name="name">Transferencia: solo almacenes asignados (usuario)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[('picking_type_id.warehouse_id.allowed_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Gestores: acceso total a transferencias -->
    <record id="rule_picking_manager" model="ir.rule">
        <field name="name">Transferencia: acceso total (gestor)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
